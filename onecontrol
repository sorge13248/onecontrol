cmd_logs() {
    ensure_xdg_runtime
    local follow=false
    local lines=50

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--follow)
                follow=true
                shift
                ;;
            -n|--lines)
                lines="${2:-50}"
                shift 2 || shift
                ;;
            *)
                shift
                ;;
        esac
    done

    if [[ "$LOCALE" == "it" ]]; then
        log_header "Log di OneControl Host Daemon"
        if [[ "$follow" == true ]]; then
            log_info "Seguendo i log in tempo reale (premi Ctrl+C per uscire)..."
            journalctl --user -u onecontrol -n "$lines" -f
        else
            journalctl --user -u onecontrol -n "$lines" --no-pager
        fi
    else
        log_header "OneControl Host Daemon Logs"
        if [[ "$follow" == true ]]; then
            log_info "Streaming logs in real-time (press Ctrl+C to exit)..."
            journalctl --user -u onecontrol -n "$lines" -f
        else
            journalctl --user -u onecontrol -n "$lines" --no-pager
        fi
    fi
}

# ------------------------------------------------------------------------------
# Local Execution / Development (Run)
# ------------------------------------------------------------------------------
cmd_run() {
    local target="${1:-}"
    shift || true

    case "$target" in
        rust)
            local mode="${1:-debug}"
            if [[ "$LOCALE" == "it" ]]; then
                log_header "Avvio OneControl Host in primo piano ($mode)"
            else
                log_header "Starting OneControl Host in foreground ($mode)"
            fi
            cd "$DAEMON_DIR"

            local bin_path
            if [[ "$mode" == "production" || "$mode" == "release" ]]; then
                bin_path="$DAEMON_DIR/target/release/onecontrol-daemon"
                if [[ ! -f "$bin_path" ]]; then
                    if [[ "$LOCALE" == "it" ]]; then
                        log_warning "Binario release non presente, compilo adesso..."
                    else
                        log_warning "Release binary not found, compiling now..."
                    fi
                    build_rust "production"
                fi
            else
                bin_path="$DAEMON_DIR/target/debug/onecontrol-daemon"
                if [[ ! -f "$bin_path" ]]; then
                    if [[ "$LOCALE" == "it" ]]; then
                        log_warning "Binario debug non presente, compilo adesso..."
                    else
                        log_warning "Debug binary not found, compiling now..."
                    fi
                    build_rust "debug"
                fi
            fi

            if [[ "$LOCALE" == "it" ]]; then
                log_info "Esecuzione di: $bin_path"
            else
                log_info "Running: $bin_path"
            fi
            export RUST_LOG="${RUST_LOG:-info,onecontrol_daemon=debug}"
            exec "$bin_path"
            ;;
        flutter)
            local platform="${1:-android}"
            setup_android_env
            local flutter_bin
            if ! flutter_bin=$(get_flutter_bin); then
                if [[ "$LOCALE" == "it" ]]; then
                    log_error "Flutter non trovato nel PATH."
                else
                    log_error "Flutter not found in PATH."
                fi
                exit 1
            fi
            if [[ "$LOCALE" == "it" ]]; then
                log_header "Avvio Flutter Mobile App ($platform)"
            else
                log_header "Starting Flutter Mobile App ($platform)"
            fi
            cd "$MOBILE_DIR"
            exec "$flutter_bin" run
            ;;
        *)
            if [[ "$LOCALE" == "it" ]]; then
                log_error "Target di esecuzione non valido: '$target'. Usa 'rust [debug|production]' o 'flutter'."
            else
                log_error "Invalid run target: '$target'. Use 'rust [debug|production]' or 'flutter'."
            fi
            exit 1
            ;;
    esac
}

