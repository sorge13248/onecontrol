# ------------------------------------------------------------------------------
# Automated Setup (Setup)
# ------------------------------------------------------------------------------
cmd_setup() {
    local target="${1:-}"
    shift || true

    case "$target" in
        uinput)
            if [[ "$LOCALE" == "it" ]]; then
                log_header "Configurazione Permessi per /dev/uinput"
                log_info "OneControl necessita di accedere a /dev/uinput per simulare mouse e tastiera."
            else
                log_header "Configuring Permissions for /dev/uinput"
                log_info "OneControl requires access to /dev/uinput to simulate virtual mouse and keyboard."
            fi

            local choice="${1:-}"
            if [[ -z "$choice" ]]; then
                if [[ -t 0 ]]; then
                    echo ""
                    if [[ "$LOCALE" == "it" ]]; then
                        echo "1) Applicare permesso immediato ACL (sudo setfacl -m u:\$USER:rw /dev/uinput)"
                        echo "2) Installare regola udev permanente (/etc/udev/rules.d/99-uinput.rules)"
                        echo "3) Applica ENTRAMBI (Consigliato)"
                        echo ""
                        read -r -p "Seleziona opzione [1-3, default 3]: " choice
                    else
                        echo "1) Apply immediate ACL permission (sudo setfacl -m u:\$USER:rw /dev/uinput)"
                        echo "2) Install persistent udev rule (/etc/udev/rules.d/99-uinput.rules)"
                        echo "3) Apply BOTH (Recommended)"
                        echo ""
                        read -r -p "Select option [1-3, default 3]: " choice
                    fi
                    choice="${choice:-3}"
                else
                    choice="3"
                fi
            fi

            case "$choice" in
                1|acl)
                    if [[ "$LOCALE" == "it" ]]; then
                        log_info "Esecuzione: sudo setfacl -m u:$USER:rw /dev/uinput"
                        sudo setfacl -m "u:$USER:rw" /dev/uinput
                        log_success "Permessi ACL impostati con successo!"
                    else
                        log_info "Running: sudo setfacl -m u:$USER:rw /dev/uinput"
                        sudo setfacl -m "u:$USER:rw" /dev/uinput
                        log_success "ACL permissions set successfully!"
                    fi
                    ;;
                2|udev)
                    if [[ "$LOCALE" == "it" ]]; then
                        log_info "Creazione regola udev..."
                        echo 'KERNEL=="uinput", MODE="0660", GROUP="input", OPTIONS+="static_node=uinput"' | sudo tee /etc/udev/rules.d/99-uinput.rules
                        sudo usermod -aG input "$USER"
                        sudo udevadm control --reload-rules && sudo udevadm trigger
                        log_success "Regola udev creata. (Nota: per il gruppo input potrebbe servire un re-login)."
                    else
                        log_info "Creating udev rule..."
                        echo 'KERNEL=="uinput", MODE="0660", GROUP="input", OPTIONS+="static_node=uinput"' | sudo tee /etc/udev/rules.d/99-uinput.rules
                        sudo usermod -aG input "$USER"
                        sudo udevadm control --reload-rules && sudo udevadm trigger
                        log_success "Udev rule created. (Note: group changes may require a re-login to take effect)."
                    fi
                    ;;
                3|both|all)
                    if [[ "$LOCALE" == "it" ]]; then
                        log_info "Creazione regola udev permanente e ACL immediata..."
                        echo 'KERNEL=="uinput", MODE="0660", GROUP="input", OPTIONS+="static_node=uinput"' | sudo tee /etc/udev/rules.d/99-uinput.rules
                        sudo usermod -aG input "$USER" 2>/dev/null || true
                        sudo udevadm control --reload-rules && sudo udevadm trigger
                        sudo setfacl -m "u:$USER:rw" /dev/uinput 2>/dev/null || true
                        log_success "Configurazione permessi completata con successo!"
                    else
                        log_info "Creating persistent udev rule and immediate ACL..."
                        echo 'KERNEL=="uinput", MODE="0660", GROUP="input", OPTIONS+="static_node=uinput"' | sudo tee /etc/udev/rules.d/99-uinput.rules
                        sudo usermod -aG input "$USER" 2>/dev/null || true
                        sudo udevadm control --reload-rules && sudo udevadm trigger
                        sudo setfacl -m "u:$USER:rw" /dev/uinput 2>/dev/null || true
                        log_success "Permission configuration completed successfully!"
                    fi
                    ;;
                *)
                    if [[ "$LOCALE" == "it" ]]; then
                        log_error "Opzione non valida: '$choice'."
                    else
                        log_error "Invalid option: '$choice'."
                    fi
                    exit 1
                    ;;
            esac
            ;;
        firewall)
            if [[ "$LOCALE" == "it" ]]; then
                log_header "Configurazione Firewall (Porta $DEFAULT_PORT TCP/UDP)"
            else
                log_header "Configuring Firewall (Port $DEFAULT_PORT TCP/UDP)"
            fi
            if command -v firewall-cmd &>/dev/null; then
                if [[ "$LOCALE" == "it" ]]; then
                    log_info "Configurazione con firewalld..."
                    sudo firewall-cmd --permanent --add-port="$DEFAULT_PORT/tcp"
                    sudo firewall-cmd --permanent --add-port="$DEFAULT_PORT/udp"
                    sudo firewall-cmd --reload
                    log_success "Porte aperte con successo su firewalld!"
                else
                    log_info "Configuring with firewalld..."
                    sudo firewall-cmd --permanent --add-port="$DEFAULT_PORT/tcp"
                    sudo firewall-cmd --permanent --add-port="$DEFAULT_PORT/udp"
                    sudo firewall-cmd --reload
                    log_success "Ports opened successfully in firewalld!"
                fi
            elif command -v ufw &>/dev/null; then
                if [[ "$LOCALE" == "it" ]]; then
                    log_info "Configurazione con UFW..."
                    sudo ufw allow "$DEFAULT_PORT/tcp"
                    sudo ufw allow "$DEFAULT_PORT/udp"
                    log_success "Porte aperte con successo su UFW!"
                else
                    log_info "Configuring with UFW..."
                    sudo ufw allow "$DEFAULT_PORT/tcp"
                    sudo ufw allow "$DEFAULT_PORT/udp"
                    log_success "Ports opened successfully in UFW!"
                fi
            else
                if [[ "$LOCALE" == "it" ]]; then
                    log_warning "Nessun gestore firewall automatico supportato rilevato (firewalld/ufw)."
                    log_info "Assicurati manualmente che la porta $DEFAULT_PORT TCP e UDP sia aperta verso la LAN."
                else
                    log_warning "No supported automated firewall manager detected (firewalld/ufw)."
                    log_info "Manually ensure that port $DEFAULT_PORT TCP and UDP is open to your local LAN."
                fi
            fi
            ;;
        *)
            if [[ "$LOCALE" == "it" ]]; then
                log_error "Argomento setup non valido: '$target'. Usa 'uinput' o 'firewall'."
            else
                log_error "Invalid setup argument: '$target'. Use 'uinput' or 'firewall'."
            fi
            exit 1
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Build and Cache Cleaning (Clean)
# ------------------------------------------------------------------------------
cmd_clean() {
    local target="${1:-all}"
    if [[ "$LOCALE" == "it" ]]; then
        log_header "Pulizia Build e Cache ($target)"
    else
        log_header "Cleaning Build Artifacts and Cache ($target)"
    fi

    case "$target" in
        rust)
            local cargo_bin
            cargo_bin=$(get_cargo_bin) || {
                [[ "$LOCALE" == "it" ]] && log_error "Cargo non trovato" || log_error "Cargo not found";
                exit 1;
            }
            (cd "$DAEMON_DIR" && "$cargo_bin" clean)
            if [[ "$LOCALE" == "it" ]]; then
                log_success "Cartella target/ di Rust pulita con successo."
            else
                log_success "Rust target/ directory cleaned successfully."
            fi
            ;;
        flutter)
            setup_android_env
            local flutter_bin
            flutter_bin=$(get_flutter_bin) || {
                [[ "$LOCALE" == "it" ]] && log_error "Flutter non trovato" || log_error "Flutter not found";
                exit 1;
            }
            (cd "$MOBILE_DIR" && "$flutter_bin" clean)
            if [[ "$LOCALE" == "it" ]]; then
                log_success "Cartella build/ di Flutter pulita con successo."
            else
                log_success "Flutter build/ directory cleaned successfully."
            fi
            ;;
        all)
            if cargo_bin=$(get_cargo_bin 2>/dev/null); then
                (cd "$DAEMON_DIR" && "$cargo_bin" clean)
            fi
            if flutter_bin=$(get_flutter_bin 2>/dev/null); then
                setup_android_env
                (cd "$MOBILE_DIR" && "$flutter_bin" clean)
            fi
            if [[ "$LOCALE" == "it" ]]; then
                log_success "Tutte le directory di build sono state pulite."
            else
                log_success "All build directories cleaned successfully."
            fi
            ;;
        *)
            if [[ "$LOCALE" == "it" ]]; then
                log_error "Target clean non valido: '$target'. Usa 'rust', 'flutter' o 'all'."
            else
                log_error "Invalid clean target: '$target'. Use 'rust', 'flutter' or 'all'."
            fi
            exit 1
            ;;
    esac
}

