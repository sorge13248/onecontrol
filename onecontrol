#!/usr/bin/env bash
# ==============================================================================
# OneControl - Unified CLI Management Script
# ==============================================================================
# Unified tool for compilation, installation, systemd service management,
# execution, testing, and diagnostics of OneControl (Rust Host Daemon + Flutter Mobile).
#
# Supports automatic OS language detection (POSIX standard: LC_ALL / LC_MESSAGES / LANG)
# with English as default and Italian for Italian locales.
# Override anytime with: ONECONTROL_LANG=it or ONECONTROL_LANG=en
# ==============================================================================

set -euo pipefail

# ------------------------------------------------------------------------------
# Directories and Project Constants
# ------------------------------------------------------------------------------
SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
PROJECT_ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"
DAEMON_DIR="$PROJECT_ROOT/daemon"
MOBILE_DIR="$PROJECT_ROOT/mobile"
DOCS_DIR="$PROJECT_ROOT/docs"

DEFAULT_PORT=53842
BIN_INSTALL_DIR="${BIN_INSTALL_DIR:-$HOME/.local/bin}"
SYSTEMD_USER_DIR="${SYSTEMD_USER_DIR:-$HOME/.config/systemd/user}"
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/onecontrol}"

# ------------------------------------------------------------------------------
# Automatic Language / Locale Detection (Linux Standard: LC_ALL, LC_MESSAGES, LANG)
# ------------------------------------------------------------------------------
detect_locale() {
    local raw="${ONECONTROL_LANG:-${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}}"
    local lower
    lower="$(echo "$raw" | tr '[:upper:]' '[:lower:]')"
    if [[ "$lower" =~ ^it ]]; then
        echo "it"
    else
        echo "en"
    fi
}
LOCALE="$(detect_locale)"

# ------------------------------------------------------------------------------
# Terminal Colors and Styling
# ------------------------------------------------------------------------------
if [[ -t 1 ]] && [[ "${NO_COLOR:-}" != "1" ]]; then
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    RESET=$'\033[0m'
    RED=$'\033[1;31m'
    GREEN=$'\033[1;32m'
    YELLOW=$'\033[1;33m'
    BLUE=$'\033[1;34m'
    CYAN=$'\033[1;36m'
    MAGENTA=$'\033[1;35m'
else
    BOLD=""
    DIM=""
    RESET=""
    RED=""
    GREEN=""
    YELLOW=""
    BLUE=""
    CYAN=""
    MAGENTA=""
fi

log_info() {
    echo -e "${BLUE}ℹ${RESET}  $*"
}

log_success() {
    echo -e "${GREEN}✔${RESET}  ${BOLD}$*${RESET}"
}

log_warning() {
    echo -e "${YELLOW}⚠${RESET}  ${BOLD}$*${RESET}"
}

log_error() {
    echo -e "${RED}✖${RESET}  ${BOLD}$*${RESET}" >&2
}

log_header() {
    echo -e "\n${CYAN}${BOLD}=== $* ===${RESET}"
}

# ------------------------------------------------------------------------------
# Toolchain & Binary Resolution
# ------------------------------------------------------------------------------
get_cargo_bin() {
    if command -v cargo &>/dev/null; then
        command -v cargo
        return 0
    fi
    if [[ -x "$HOME/.cargo/bin/cargo" ]]; then
        echo "$HOME/.cargo/bin/cargo"
        return 0
    fi
    return 1
}

get_rustc_bin() {
    if command -v rustc &>/dev/null; then
        command -v rustc
        return 0
    fi
    if [[ -x "$HOME/.cargo/bin/rustc" ]]; then
        echo "$HOME/.cargo/bin/rustc"
        return 0
    fi
    return 1
}

get_flutter_bin() {
    if [[ -n "${FLUTTER_BIN:-}" && -x "$FLUTTER_BIN" ]]; then
        echo "$FLUTTER_BIN"
        return 0
    fi

    if command -v flutter &>/dev/null; then
        command -v flutter
        return 0
    fi

    # Check in mobile/android/local.properties
    local prop_file="$MOBILE_DIR/android/local.properties"
    if [[ -f "$prop_file" ]]; then
        local sdk_path
        sdk_path=$(grep -E '^flutter.sdk=' "$prop_file" 2>/dev/null | cut -d'=' -f2- | tr -d '\r')
        if [[ -n "$sdk_path" && -x "$sdk_path/bin/flutter" ]]; then
            echo "$sdk_path/bin/flutter"
            return 0
        fi
    fi

    # Known system / installation paths
    local candidate_paths=(
        "$HOME/flutter/bin/flutter"
        "$HOME/.local/bin/flutter"
        "/opt/flutter/bin/flutter"
        "/usr/local/flutter/bin/flutter"
    )
    for p in "${candidate_paths[@]}"; do
        if [[ -x "$p" ]]; then
            echo "$p"
            return 0
        fi
    done

    if [[ -n "${FLUTTER_ROOT:-}" && -x "$FLUTTER_ROOT/bin/flutter" ]]; then
        echo "$FLUTTER_ROOT/bin/flutter"
        return 0
    fi

    return 1
}

get_adb_bin() {
    if [[ -n "${ADB_BIN:-}" && -x "$ADB_BIN" ]]; then
        echo "$ADB_BIN"
        return 0
    fi

    if command -v adb &>/dev/null; then
        command -v adb
        return 0
    fi

    local prop_file="$MOBILE_DIR/android/local.properties"
    if [[ -f "$prop_file" ]]; then
        local sdk_path
        sdk_path=$(grep -E '^sdk.dir=' "$prop_file" 2>/dev/null | cut -d'=' -f2- | tr -d '\r')
        if [[ -n "$sdk_path" && -x "$sdk_path/platform-tools/adb" ]]; then
            echo "$sdk_path/platform-tools/adb"
            return 0
        fi
    fi

    local candidate_paths=(
        "$HOME/Android/Sdk/platform-tools/adb"
        "$HOME/.local/bin/adb"
        "/opt/android-sdk/platform-tools/adb"
    )
    for p in "${candidate_paths[@]}"; do
        if [[ -x "$p" ]]; then
            echo "$p"
            return 0
        fi
    done

    return 1
}

setup_android_env() {
    # Avoid permission issues with ADB if HOME is read-only (e.g. sandbox/container)
    if [[ ! -w "$HOME" && ! -d "$HOME/.android" ]]; then
        export ANDROID_USER_HOME="${ANDROID_USER_HOME:-/tmp/.android}"
    fi

    local prop_file="$MOBILE_DIR/android/local.properties"
    if [[ -f "$prop_file" ]]; then
        local sdk_path
        sdk_path=$(grep -E '^sdk.dir=' "$prop_file" 2>/dev/null | cut -d'=' -f2- | tr -d '\r')
        if [[ -n "$sdk_path" && -d "$sdk_path" ]]; then
            export ANDROID_HOME="${ANDROID_HOME:-$sdk_path}"
            export ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-$sdk_path}"
        fi
        local flutter_sdk
        flutter_sdk=$(grep -E '^flutter.sdk=' "$prop_file" 2>/dev/null | cut -d'=' -f2- | tr -d '\r')
        if [[ -n "$flutter_sdk" && -d "$flutter_sdk/bin" ]]; then
            if [[ ":$PATH:" != *":$flutter_sdk/bin:"* ]]; then
                export PATH="$flutter_sdk/bin:$PATH"
            fi
        fi
    fi
}

# ------------------------------------------------------------------------------
# Compilation Commands (Build)
# ------------------------------------------------------------------------------
build_rust() {
    local mode="${1:-production}"
    local cargo_bin
    if ! cargo_bin=$(get_cargo_bin); then
        if [[ "$LOCALE" == "it" ]]; then
            log_error "Cargo/Rust non trovato nel sistema o in ~/.cargo/bin."
            log_info "Installa Rust con: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
        else
            log_error "Cargo/Rust not found on system or in ~/.cargo/bin."
            log_info "Install Rust using: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
        fi
        exit 1
    fi

    if [[ "$LOCALE" == "it" ]]; then
        log_header "Compilazione Rust Host Daemon (Modalità: $mode)"
    else
        log_header "Compiling Rust Host Daemon (Mode: $mode)"
    fi
    cd "$DAEMON_DIR"

    case "$mode" in
        production|release)
            if [[ "$LOCALE" == "it" ]]; then
                log_info "Esecuzione: cargo build --release"
            else
                log_info "Running: cargo build --release"
            fi
            "$cargo_bin" build --release
            local target_bin="$DAEMON_DIR/target/release/onecontrol-daemon"
            if [[ -f "$target_bin" ]]; then
                local size
                size=$(du -h "$target_bin" | cut -f1)
                if [[ "$LOCALE" == "it" ]]; then
                    log_success "Build completata con successo! Binario: $target_bin ($size)"
                else
                    log_success "Build completed successfully! Binary: $target_bin ($size)"
                fi
            fi
            ;;
        debug)
            if [[ "$LOCALE" == "it" ]]; then
                log_info "Esecuzione: cargo build (debug)"
            else
                log_info "Running: cargo build (debug)"
            fi
            "$cargo_bin" build
            local target_bin="$DAEMON_DIR/target/debug/onecontrol-daemon"
            if [[ -f "$target_bin" ]]; then
                local size
                size=$(du -h "$target_bin" | cut -f1)
                if [[ "$LOCALE" == "it" ]]; then
                    log_success "Build debug completata con successo! Binario: $target_bin ($size)"
                else
                    log_success "Debug build completed successfully! Binary: $target_bin ($size)"
                fi
            fi
            ;;
        *)
            if [[ "$LOCALE" == "it" ]]; then
                log_error "Modalità di build Rust non valida: '$mode'. Usa 'production' (o 'release') o 'debug'."
            else
                log_error "Invalid Rust build mode: '$mode'. Use 'production' (or 'release') or 'debug'."
            fi
            exit 1
            ;;
    esac
}

build_flutter_android() {
    local mode="${1:-production}"
    setup_android_env

    local flutter_bin
    if ! flutter_bin=$(get_flutter_bin); then
        if [[ "$LOCALE" == "it" ]]; then
            log_error "Flutter SDK non trovato nel PATH o nei percorsi configurati."
            log_info "Verifica la presenza di Flutter o imposta flutter.sdk in mobile/android/local.properties"
        else
            log_error "Flutter SDK not found in PATH or configured paths."
            log_info "Ensure Flutter is installed or set flutter.sdk in mobile/android/local.properties"
        fi
        exit 1
    fi

    if [[ "$LOCALE" == "it" ]]; then
        log_header "Compilazione Flutter Android (Modalità: $mode)"
    else
        log_header "Compiling Flutter Android (Mode: $mode)"
    fi
    cd "$MOBILE_DIR"

    case "$mode" in
        production|release)
            if [[ "$LOCALE" == "it" ]]; then
                log_info "Esecuzione: flutter build apk --release"
            else
                log_info "Running: flutter build apk --release"
            fi
            "$flutter_bin" build apk --release
            local apk_path="$MOBILE_DIR/build/app/outputs/flutter-apk/app-release.apk"
            if [[ -f "$apk_path" ]]; then
                local size
                size=$(du -h "$apk_path" | cut -f1)
                if [[ "$LOCALE" == "it" ]]; then
                    log_success "APK release generato con successo!"
                    echo -e "  📁 Posizione: ${BOLD}$apk_path${RESET} ($size)"
                    echo -e "  💡 Installa sullo smartphone con: ${CYAN}./onecontrol install-apk release${RESET}"
                else
                    log_success "Release APK generated successfully!"
                    echo -e "  📁 Location: ${BOLD}$apk_path${RESET} ($size)"
                    echo -e "  💡 Install on phone using: ${CYAN}./onecontrol install-apk release${RESET}"
                fi
            fi
            ;;
        debug)
            if [[ "$LOCALE" == "it" ]]; then
                log_info "Esecuzione: flutter build apk --debug"
            else
                log_info "Running: flutter build apk --debug"
            fi
            "$flutter_bin" build apk --debug
            local apk_path="$MOBILE_DIR/build/app/outputs/flutter-apk/app-debug.apk"
            if [[ -f "$apk_path" ]]; then
                local size
                size=$(du -h "$apk_path" | cut -f1)
                if [[ "$LOCALE" == "it" ]]; then
                    log_success "APK debug generato con successo!"
                    echo -e "  📁 Posizione: ${BOLD}$apk_path${RESET} ($size)"
                    echo -e "  💡 Installa sullo smartphone con: ${CYAN}./onecontrol install-apk debug${RESET}"
                else
                    log_success "Debug APK generated successfully!"
                    echo -e "  📁 Location: ${BOLD}$apk_path${RESET} ($size)"
                    echo -e "  💡 Install on phone using: ${CYAN}./onecontrol install-apk debug${RESET}"
                fi
            fi
            ;;
        split)
            if [[ "$LOCALE" == "it" ]]; then
                log_info "Esecuzione: flutter build apk --split-per-abi"
            else
                log_info "Running: flutter build apk --split-per-abi"
            fi
            "$flutter_bin" build apk --split-per-abi
            local apk_dir="$MOBILE_DIR/build/app/outputs/flutter-apk"
            if [[ "$LOCALE" == "it" ]]; then
                log_success "APK suddivisi per architettura generati in $apk_dir:"
            else
                log_success "Architecture-split APKs generated in $apk_dir:"
            fi
            find "$apk_dir" -maxdepth 1 -name "app-*-release.apk" -exec du -h {} +
            ;;
        *)
            if [[ "$LOCALE" == "it" ]]; then
                log_error "Modalità di build Flutter non valida: '$mode'. Usa 'production', 'debug' o 'split'."
            else
                log_error "Invalid Flutter build mode: '$mode'. Use 'production', 'debug' or 'split'."
            fi
            exit 1
            ;;
    esac
}

cmd_build() {
    local target="${1:-}"
    shift || true

    case "$target" in
        rust)
            local mode="${1:-production}"
            build_rust "$mode"
            ;;
        flutter)
            local platform="${1:-android}"
            shift || true
            case "$platform" in
                android)
                    local mode="${1:-production}"
                    build_flutter_android "$mode"
                    ;;
                *)
                    if [[ "$LOCALE" == "it" ]]; then
                        log_error "Piattaforma Flutter non valida: '$platform'. Piattaforme supportate: 'android'."
                    else
                        log_error "Invalid Flutter platform: '$platform'. Supported platforms: 'android'."
                    fi
                    exit 1
                    ;;
            esac
            ;;
        all)
            local mode="${1:-production}"
            build_rust "$mode"
            build_flutter_android "$mode"
            ;;
        "")
            if [[ "$LOCALE" == "it" ]]; then
                log_error "Parametro build mancante. Sintassi disponibili:"
            else
                log_error "Missing build target parameter. Available syntax:"
            fi
            echo -e "  ${CYAN}./onecontrol build rust [production|debug]${RESET}"
            echo -e "  ${CYAN}./onecontrol build flutter android [production|debug|split]${RESET}"
            echo -e "  ${CYAN}./onecontrol build all [production|debug]${RESET}"
            exit 1
            ;;
        *)
            if [[ "$LOCALE" == "it" ]]; then
                log_error "Target di compilazione sconosciuto: '$target'."
            else
                log_error "Unknown build target: '$target'."
            fi
            exit 1
            ;;
    esac
}

# ------------------------------------------------------------------------------
# Host Systemd Service Installation & Update
# ------------------------------------------------------------------------------
cmd_install() {
    if [[ "$LOCALE" == "it" ]]; then
        log_header "Installazione / Aggiornamento OneControl Host Daemon"
        log_info "[1/4] Compilazione in modalità release (ottimizzata)..."
    else
        log_header "Installing / Updating OneControl Host Daemon"
        log_info "[1/4] Compiling in release mode (optimized)..."
    fi
    build_rust "production"

    local src_bin="$DAEMON_DIR/target/release/onecontrol-daemon"
    if [[ ! -f "$src_bin" ]]; then
        if [[ "$LOCALE" == "it" ]]; then
            log_error "Binario compilato non trovato in $src_bin"
        else
            log_error "Compiled binary not found at $src_bin"
        fi
        exit 1
    fi

    # Step 2: Copy to user PATH ~/.local/bin
    if [[ "$LOCALE" == "it" ]]; then
        log_info "[2/4] Installazione del binario in $BIN_INSTALL_DIR/onecontrol-daemon..."
    else
        log_info "[2/4] Installing binary to $BIN_INSTALL_DIR/onecontrol-daemon..."
    fi
    mkdir -p "$BIN_INSTALL_DIR"
    local dest_bin="$BIN_INSTALL_DIR/onecontrol-daemon"

    # Atomic rename (mv) to support hot update without ETXTBSY
    install -m 755 "$src_bin" "${dest_bin}.tmp"
    mv -f "${dest_bin}.tmp" "$dest_bin"
    if [[ "$LOCALE" == "it" ]]; then
        log_success "Binario installato con successo: $dest_bin"
    else
        log_success "Binary installed successfully: $dest_bin"
    fi

    # Step 3: Install Systemd unit file and desktop icons
    if [[ "$LOCALE" == "it" ]]; then
        log_info "[3/4] Installazione della unit systemd e icone applicazione..."
    else
        log_info "[3/4] Installing systemd unit and application icons..."
    fi
    mkdir -p "$SYSTEMD_USER_DIR"
    local src_service="$DAEMON_DIR/onecontrol.service"
    local dest_service="$SYSTEMD_USER_DIR/onecontrol.service"

    if [[ ! -f "$src_service" ]]; then
        if [[ "$LOCALE" == "it" ]]; then
            log_error "File di unit $src_service non trovato!"
        else
            log_error "Service unit file not found at $src_service!"
        fi
        exit 1
    fi

    install -m 644 "$src_service" "$dest_service"
    if [[ "$LOCALE" == "it" ]]; then
        log_success "Unit systemd installata in: $dest_service"
    else
        log_success "Systemd unit installed at: $dest_service"
    fi

    local icon_hicolor_dir="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor"
    mkdir -p "$icon_hicolor_dir/512x512/apps" "$icon_hicolor_dir/scalable/apps" 2>/dev/null || true
    if [[ -f "$PROJECT_ROOT/assets/icons/onecontrol.png" && -d "$icon_hicolor_dir/512x512/apps" ]]; then
        install -m 644 "$PROJECT_ROOT/assets/icons/onecontrol.png" "$icon_hicolor_dir/512x512/apps/onecontrol.png" 2>/dev/null || true
    fi
    if [[ -f "$PROJECT_ROOT/assets/icons/onecontrol.svg" && -d "$icon_hicolor_dir/scalable/apps" ]]; then
        install -m 644 "$PROJECT_ROOT/assets/icons/onecontrol.svg" "$icon_hicolor_dir/scalable/apps/onecontrol.svg" 2>/dev/null || true
    fi

    # Step 4: Systemd reload and service activation
    if [[ "$LOCALE" == "it" ]]; then
        log_info "[4/4] Ricarica del demone systemd e attivazione/riavvio del servizio..."
    else
        log_info "[4/4] Reloading systemd daemon and enabling/restarting service..."
    fi
    
    # Ensure XDG_RUNTIME_DIR is populated if available
    if [[ -z "${XDG_RUNTIME_DIR:-}" && -d "/run/user/$(id -u)" ]]; then
        export XDG_RUNTIME_DIR="/run/user/$(id -u)"
    fi

    if systemctl --user daemon-reload 2>/dev/null; then
        systemctl --user enable onecontrol.service 2>/dev/null || true
        systemctl --user restart onecontrol.service

        sleep 0.5
        if systemctl --user is-active --quiet onecontrol.service; then
            local pid
            pid=$(systemctl --user show --property MainPID --value onecontrol.service 2>/dev/null || true)
            if [[ "$LOCALE" == "it" ]]; then
                log_success "Servizio OneControl attivo ed in esecuzione! (PID: ${pid:-attivo})"
            else
                log_success "OneControl service active and running! (PID: ${pid:-active})"
            fi
        else
            if [[ "$LOCALE" == "it" ]]; then
                log_warning "Il servizio è stato registrato ma non risulta in stato 'active'."
                log_info "Visualizza i log di errore con: journalctl --user -u onecontrol -n 25 --no-pager"
            else
                log_warning "The service was registered but is not currently 'active'."
                log_info "View error logs with: journalctl --user -u onecontrol -n 25 --no-pager"
            fi
        fi
    else
        if [[ "$LOCALE" == "it" ]]; then
            log_warning "Impossibile comunicare direttamente con il gestore systemd utente in questa sessione."
            log_info "I file sono stati installati. Per completare l'avvio nel tuo ambiente desktop esegui:"
            echo -e "  ${CYAN}systemctl --user daemon-reload${RESET}"
            echo -e "  ${CYAN}systemctl --user enable --now onecontrol.service${RESET}"
        else
            log_warning "Could not communicate directly with the user systemd manager in this session."
            log_info "Files were installed. To start the service in your desktop session, run:"
            echo -e "  ${CYAN}systemctl --user daemon-reload${RESET}"
            echo -e "  ${CYAN}systemctl --user enable --now onecontrol.service${RESET}"
        fi
    fi

    # Post-installation checks
    echo ""
    if [[ "$LOCALE" == "it" ]]; then
        log_header "Riepilogo Installazione e Controlli"
    else
        log_header "Installation Summary & Health Checks"
    fi

    # Check if ~/.local/bin is in PATH
    if [[ ":$PATH:" != *":$BIN_INSTALL_DIR:"* ]]; then
        if [[ "$LOCALE" == "it" ]]; then
            log_warning "$BIN_INSTALL_DIR non è presente nella variabile PATH corrente."
            echo -e "  Aggiungi al tuo ${BOLD}~/.bashrc${RESET} o ${BOLD}~/.zshrc${RESET}:"
            echo -e "  ${CYAN}export PATH=\"\$HOME/.local/bin:\$PATH\"${RESET}"
        else
            log_warning "$BIN_INSTALL_DIR is not present in your current PATH variable."
            echo -e "  Add this to your ${BOLD}~/.bashrc${RESET} or ${BOLD}~/.zshrc${RESET}:"
            echo -e "  ${CYAN}export PATH=\"\$HOME/.local/bin:\$PATH\"${RESET}"
        fi
    else
        if [[ "$LOCALE" == "it" ]]; then
            log_success "$BIN_INSTALL_DIR è presente nel PATH di sistema."
        else
            log_success "$BIN_INSTALL_DIR is present in the system PATH."
        fi
    fi

    # Check /dev/uinput permissions
    if [[ -r /dev/uinput && -w /dev/uinput ]]; then
        if [[ "$LOCALE" == "it" ]]; then
            log_success "Permessi su /dev/uinput verificati (lettura e scrittura OK)."
        else
            log_success "Permissions on /dev/uinput verified (read and write OK)."
        fi
    else
        if [[ "$LOCALE" == "it" ]]; then
            log_warning "Attenzione: l'utente '$USER' non ha attualmente permessi di scrittura su /dev/uinput!"
            log_info "Configura i permessi necessari eseguendo:"
            echo -e "  ${CYAN}./onecontrol setup uinput${RESET}"
        else
            log_warning "Notice: user '$USER' does not currently have write access to /dev/uinput!"
            log_info "Configure required permissions by running:"
            echo -e "  ${CYAN}./onecontrol setup uinput${RESET}"
        fi
    fi

    echo ""
    if [[ "$LOCALE" == "it" ]]; then
        log_success "Installazione / Aggiornamento completato con successo!"
        echo -e "Comandi utili:"
        echo -e "  Stato del servizio:     ${CYAN}./onecontrol status${RESET}"
        echo -e "  Log in tempo reale:     ${CYAN}./onecontrol logs -f${RESET}"
        echo -e "  Riavvio del servizio:   ${CYAN}./onecontrol restart${RESET}"
        echo -e "  Arresto del servizio:   ${CYAN}./onecontrol stop${RESET}"
    else
        log_success "Installation / Update completed successfully!"
        echo -e "Useful commands:"
        echo -e "  Service status:   ${CYAN}./onecontrol status${RESET}"
        echo -e "  Real-time logs:   ${CYAN}./onecontrol logs -f${RESET}"
        echo -e "  Restart service:  ${CYAN}./onecontrol restart${RESET}"
        echo -e "  Stop service:     ${CYAN}./onecontrol stop${RESET}"
    fi
}

cmd_uninstall() {
    if [[ "$LOCALE" == "it" ]]; then
        log_header "Disinstallazione OneControl Host Daemon"
    else
        log_header "Uninstalling OneControl Host Daemon"
    fi

    if [[ -z "${XDG_RUNTIME_DIR:-}" && -d "/run/user/$(id -u)" ]]; then
        export XDG_RUNTIME_DIR="/run/user/$(id -u)"
    fi

    if [[ "$LOCALE" == "it" ]]; then
        log_info "Arresto e disabilitazione della unit systemd..."
    else
        log_info "Stopping and disabling systemd unit..."
    fi
    systemctl --user stop onecontrol.service 2>/dev/null || true
    systemctl --user disable onecontrol.service 2>/dev/null || true

    local service_file="$SYSTEMD_USER_DIR/onecontrol.service"
    if [[ -f "$service_file" ]]; then
        rm -f "$service_file"
        if [[ "$LOCALE" == "it" ]]; then
            log_success "Rimosso: $service_file"
        else
            log_success "Removed: $service_file"
        fi
    fi

    systemctl --user daemon-reload 2>/dev/null || true

    local bin_file="$BIN_INSTALL_DIR/onecontrol-daemon"
    if [[ -f "$bin_file" ]]; then
        rm -f "$bin_file"
        if [[ "$LOCALE" == "it" ]]; then
            log_success "Rimosso: $bin_file"
        else
            log_success "Removed: $bin_file"
        fi
    fi

    local icon_hicolor_dir="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor"
    rm -f "$icon_hicolor_dir/512x512/apps/onecontrol.png" 2>/dev/null || true
    rm -f "$icon_hicolor_dir/scalable/apps/onecontrol.svg" 2>/dev/null || true

    if [[ "$LOCALE" == "it" ]]; then
