# ------------------------------------------------------------------------------
# Main Entry Point
# ------------------------------------------------------------------------------
main() {
    if [[ $# -eq 0 ]]; then
        cmd_help
        exit 0
    fi

    local action="$1"
    shift

    case "$action" in
        build)
            cmd_build "$@"
            ;;
        install)
            cmd_install "$@"
            ;;
        uninstall)
            cmd_uninstall "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        start)
            cmd_start "$@"
            ;;
        stop)
            cmd_stop "$@"
            ;;
        restart)
            cmd_restart "$@"
            ;;
        logs)
            cmd_logs "$@"
            ;;
        run)
            cmd_run "$@"
            ;;
        test)
            cmd_test "$@"
            ;;
        bump|bump-version)
            cmd_bump "$@"
            ;;
        devices)
            cmd_devices "$@"
            ;;
        install-apk|apk-install)
            cmd_install_apk "$@"
            ;;
        doctor|check)
            cmd_doctor "$@"
            ;;
        setup)
            cmd_setup "$@"
            ;;
        setup-uinput)
            cmd_setup "uinput" "$@"
            ;;
        setup-firewall)
            cmd_setup "firewall" "$@"
            ;;
        clean)
            cmd_clean "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        *)
            if [[ "$LOCALE" == "it" ]]; then
                log_error "Comando sconosciuto: '$action'"
            else
                log_error "Unknown command: '$action'"
            fi
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
