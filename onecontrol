# ------------------------------------------------------------------------------
# System Diagnostics (Doctor / Check)
# ------------------------------------------------------------------------------
cmd_doctor() {
    if [[ "$LOCALE" == "it" ]]; then
        log_header "OneControl Doctor - Diagnostica e Requisiti di Sistema"
    else
        log_header "OneControl Doctor - System Diagnostics & Requirements"
    fi
    local issues=0

    # 1. Operating System
    if [[ "$LOCALE" == "it" ]]; then
        echo -e "${BOLD}[Sistema Operativo]${RESET}"
        echo -e "  • Kernel:    $(uname -s) $(uname -r) ($(uname -m))"
        echo -e "  • Utente:    $USER (UID: $(id -u))"
    else
        echo -e "${BOLD}[Operating System]${RESET}"
        echo -e "  • Kernel:    $(uname -s) $(uname -r) ($(uname -m))"
        echo -e "  • User:      $USER (UID: $(id -u))"
    fi

    # 2. Rust & Cargo
    if [[ "$LOCALE" == "it" ]]; then
        echo -e "\n${BOLD}[Toolchain Rust]${RESET}"
    else
        echo -e "\n${BOLD}[Rust Toolchain]${RESET}"
    fi
    local cargo_bin
    if cargo_bin=$(get_cargo_bin 2>/dev/null); then
        local cargo_ver
        cargo_ver=$("$cargo_bin" --version)
        echo -e "  • Cargo:     ${GREEN}$( [[ "$LOCALE" == "it" ]] && echo "trovato" || echo "found" )${RESET} ($cargo_ver)"
    else
        echo -e "  • Cargo:     ${RED}$( [[ "$LOCALE" == "it" ]] && echo "NON trovato" || echo "NOT found" )${RESET}"
        ((issues++))
    fi

    local rustc_bin
    if rustc_bin=$(get_rustc_bin 2>/dev/null); then
        local rustc_ver
        rustc_ver=$("$rustc_bin" --version)
        echo -e "  • Rustc:     ${GREEN}$( [[ "$LOCALE" == "it" ]] && echo "trovato" || echo "found" )${RESET} ($rustc_ver)"
    else
        echo -e "  • Rustc:     ${RED}$( [[ "$LOCALE" == "it" ]] && echo "NON trovato" || echo "NOT found" )${RESET}"
        ((issues++))
    fi

    # 3. Flutter & Android SDK
    if [[ "$LOCALE" == "it" ]]; then
        echo -e "\n${BOLD}[Ambiente Mobile (Flutter / Android)]${RESET}"
    else
        echo -e "\n${BOLD}[Mobile Environment (Flutter / Android)]${RESET}"
    fi
    setup_android_env
    local flutter_bin
    if flutter_bin=$(get_flutter_bin 2>/dev/null); then
        local flutter_ver
        flutter_ver=$("$flutter_bin" --version 2>/dev/null | head -n 1 || echo "Flutter ($flutter_bin)")
        echo -e "  • Flutter:   ${GREEN}$( [[ "$LOCALE" == "it" ]] && echo "trovato" || echo "found" )${RESET} ($flutter_ver)"
    else
        local prop_file="$MOBILE_DIR/android/local.properties"
        local sdk_path=""
        if [[ -f "$prop_file" ]]; then
            sdk_path=$(grep -E '^flutter.sdk=' "$prop_file" 2>/dev/null | cut -d'=' -f2- | tr -d '\r')
        fi
        if [[ -n "$sdk_path" ]]; then
            echo -e "  • Flutter:   ${YELLOW}$( [[ "$LOCALE" == "it" ]] && echo "configurato in local.properties ($sdk_path)" || echo "configured in local.properties ($sdk_path)" )${RESET}"
        else
            echo -e "  • Flutter:   ${YELLOW}$( [[ "$LOCALE" == "it" ]] && echo "NON trovato nel PATH corrente" || echo "NOT found in current PATH" )${RESET}"
        fi
    fi

    local adb_bin
    if adb_bin=$(get_adb_bin 2>/dev/null); then
        local adb_ver
        adb_ver=$("$adb_bin" --version 2>/dev/null | head -n 1 || echo "ADB")
        echo -e "  • ADB:       ${GREEN}$( [[ "$LOCALE" == "it" ]] && echo "trovato" || echo "found" )${RESET} ($adb_ver)"
    else
        echo -e "  • ADB:       ${YELLOW}$( [[ "$LOCALE" == "it" ]] && echo "NON trovato nel PATH" || echo "NOT found in PATH" )${RESET}"
    fi

    # 4. Kernel /dev/uinput
    if [[ "$LOCALE" == "it" ]]; then
        echo -e "\n${BOLD}[Driver Dispositivi Kernel (/dev/uinput)]${RESET}"
    else
        echo -e "\n${BOLD}[Kernel Device Driver (/dev/uinput)]${RESET}"
    fi
    if [[ -e /dev/uinput ]]; then
        echo -e "  • Device node:      ${GREEN}$( [[ "$LOCALE" == "it" ]] && echo "/dev/uinput presente" || echo "/dev/uinput present" )${RESET}"
    else
        echo -e "  • Device node:      ${RED}$( [[ "$LOCALE" == "it" ]] && echo "/dev/uinput NON presente (esegui: sudo modprobe uinput)" || echo "/dev/uinput NOT present (run: sudo modprobe uinput)" )${RESET}"
        ((issues++))
    fi

    if [[ -r /dev/uinput && -w /dev/uinput ]]; then
        echo -e "  • User permissions: ${GREEN}$( [[ "$LOCALE" == "it" ]] && echo "OK (lettura/scrittura concessa per $USER)" || echo "OK (read and write allowed for $USER)" )${RESET}"
    else
        echo -e "  • User permissions: ${RED}$( [[ "$LOCALE" == "it" ]] && echo "MANCANTI (l'utente $USER non ha permessi rw su /dev/uinput)" || echo "MISSING (user $USER does not have rw permissions on /dev/uinput)" )${RESET}"
        echo -e "    💡 $( [[ "$LOCALE" == "it" ]] && echo "Risolvi subito con:" || echo "Fix immediately with:" ) ${CYAN}./onecontrol setup uinput${RESET}"
        ((issues++))
    fi

    # 5. Desktop Notifications
    if [[ "$LOCALE" == "it" ]]; then
        echo -e "\n${BOLD}[Notifiche Desktop (Server di notifica)]${RESET}"
    else
        echo -e "\n${BOLD}[Desktop Notifications (Notification Daemon)]${RESET}"
    fi
    if command -v notify-send &>/dev/null; then
        echo -e "  • notify-send:      ${GREEN}$( [[ "$LOCALE" == "it" ]] && echo "presente" || echo "present" )${RESET}"
    else
        echo -e "  • notify-send:      ${YELLOW}$( [[ "$LOCALE" == "it" ]] && echo "non trovato (PIN visibile nei log/terminale)" || echo "not found (PIN will only be visible in daemon logs/terminal)" )${RESET}"
    fi

    # 6. Firewall & Port 53842
    if [[ "$LOCALE" == "it" ]]; then
        echo -e "\n${BOLD}[Rete e Firewall (Porta $DEFAULT_PORT TCP/UDP)]${RESET}"
    else
        echo -e "\n${BOLD}[Network & Firewall (Port $DEFAULT_PORT TCP/UDP)]${RESET}"
    fi
    local fw_found=false
    if command -v firewall-cmd &>/dev/null; then
        fw_found=true
        local tcp_ok udp_ok
        tcp_ok=$(sudo -n firewall-cmd --query-port="$DEFAULT_PORT/tcp" 2>/dev/null || firewall-cmd --query-port="$DEFAULT_PORT/tcp" 2>/dev/null || echo "no")
        udp_ok=$(sudo -n firewall-cmd --query-port="$DEFAULT_PORT/udp" 2>/dev/null || firewall-cmd --query-port="$DEFAULT_PORT/udp" 2>/dev/null || echo "no")
        if [[ "$tcp_ok" == "yes" && "$udp_ok" == "yes" ]]; then
            echo -e "  • firewalld: ${GREEN}$( [[ "$LOCALE" == "it" ]] && echo "Porta $DEFAULT_PORT TCP/UDP aperta" || echo "Port $DEFAULT_PORT TCP/UDP open" )${RESET}"
        else
            echo -e "  • firewalld: ${YELLOW}$( [[ "$LOCALE" == "it" ]] && echo "Porta $DEFAULT_PORT non aperta (TCP: $tcp_ok, UDP: $udp_ok)" || echo "Port $DEFAULT_PORT not open (TCP: $tcp_ok, UDP: $udp_ok)" )${RESET}"
            echo -e "    💡 $( [[ "$LOCALE" == "it" ]] && echo "Configura automaticamente con:" || echo "Configure automatically with:" ) ${CYAN}./onecontrol setup firewall${RESET}"
        fi
    elif command -v ufw &>/dev/null; then
        fw_found=true
        if sudo -n ufw status 2>/dev/null | grep -q "$DEFAULT_PORT"; then
            echo -e "  • UFW:       ${GREEN}$( [[ "$LOCALE" == "it" ]] && echo "Regole per porta $DEFAULT_PORT trovate" || echo "Rules for port $DEFAULT_PORT found" )${RESET}"
        else
            echo -e "  • UFW:       ${YELLOW}$( [[ "$LOCALE" == "it" ]] && echo "Nessuna regola rilevata per la porta $DEFAULT_PORT" || echo "No rule detected for port $DEFAULT_PORT" )${RESET}"
            echo -e "    💡 $( [[ "$LOCALE" == "it" ]] && echo "Configura automaticamente con:" || echo "Configure automatically with:" ) ${CYAN}./onecontrol setup firewall${RESET}"
        fi
    fi
    if [[ "$fw_found" == false ]]; then
        if [[ "$LOCALE" == "it" ]]; then
            echo -e "  • Firewall:  Nessun gestore firewalld/ufw rilevato o attivo."
        else
            echo -e "  • Firewall:  No firewalld/ufw service detected or active."
        fi
    fi

    # 7. Systemd Service
    if [[ "$LOCALE" == "it" ]]; then
        echo -e "\n${BOLD}[Servizio Systemd Utente]${RESET}"
        local installed_service="$SYSTEMD_USER_DIR/onecontrol.service"
        local installed_bin="$BIN_INSTALL_DIR/onecontrol-daemon"
