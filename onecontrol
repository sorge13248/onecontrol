# ------------------------------------------------------------------------------
# Systemd Service Management (Status, Start, Stop, Restart, Logs)
# ------------------------------------------------------------------------------
ensure_xdg_runtime() {
    if [[ -z "${XDG_RUNTIME_DIR:-}" && -d "/run/user/$(id -u)" ]]; then
        export XDG_RUNTIME_DIR="/run/user/$(id -u)"
    fi
}

cmd_status() {
    ensure_xdg_runtime
    if [[ "$LOCALE" == "it" ]]; then
        log_header "Stato Servizio OneControl Host"
    else
        log_header "OneControl Host Service Status"
    fi

    local is_active="unknown"
    local is_enabled="unknown"
    if systemctl --user is-active --quiet onecontrol.service 2>/dev/null; then
        is_active="${GREEN}$( [[ "$LOCALE" == "it" ]] && echo "attivo (running)" || echo "active (running)" )${RESET}"
    else
        is_active="${RED}$( [[ "$LOCALE" == "it" ]] && echo "inattivo (stopped)" || echo "inactive (stopped)" )${RESET}"
    fi

    if systemctl --user is-enabled --quiet onecontrol.service 2>/dev/null; then
        is_enabled="${GREEN}$( [[ "$LOCALE" == "it" ]] && echo "abilitato (avvio automatico al login)" || echo "enabled (starts automatically on login)" )${RESET}"
    else
        is_enabled="${YELLOW}$( [[ "$LOCALE" == "it" ]] && echo "disabilitato" || echo "disabled" )${RESET}"
    fi

    if [[ "$LOCALE" == "it" ]]; then
        echo -e "  • Servizio Systemd:     $is_active"
        echo -e "  • Avvio Automatico:     $is_enabled"
    else
        echo -e "  • Systemd Service:    $is_active"
        echo -e "  • Autostart on Login: $is_enabled"
    fi

    # Check daemon process
    local pids
    pids=$(pgrep -d', ' onecontrol-daemon 2>/dev/null || true)
    if [[ -n "$pids" ]]; then
        if [[ "$LOCALE" == "it" ]]; then
            echo -e "  • Processo demone:      ${GREEN}in esecuzione${RESET} (PID: $pids)"
        else
            echo -e "  • Daemon Process:     ${GREEN}running${RESET} (PID: $pids)"
        fi
    else
        if [[ "$LOCALE" == "it" ]]; then
            echo -e "  • Processo demone:      ${RED}non trovato${RESET}"
        else
            echo -e "  • Daemon Process:     ${RED}not found${RESET}"
        fi
    fi

    # Check listening network port
    local port_info=""
    if command -v ss &>/dev/null; then
        port_info=$(ss -tulpn 2>/dev/null | grep ":$DEFAULT_PORT " || true)
    elif command -v lsof &>/dev/null; then
        port_info=$(lsof -i ":$DEFAULT_PORT" 2>/dev/null || true)
    fi

    if [[ -n "$port_info" ]]; then
        if [[ "$LOCALE" == "it" ]]; then
            echo -e "  • Porta di rete ($DEFAULT_PORT): ${GREEN}in ascolto${RESET}"
        else
            echo -e "  • Network Port ($DEFAULT_PORT): ${GREEN}listening${RESET}"
        fi
    else
        if [[ "$LOCALE" == "it" ]]; then
            echo -e "  • Porta di rete ($DEFAULT_PORT): ${YELLOW}nessun processo rilevato in ascolto${RESET}"
        else
            echo -e "  • Network Port ($DEFAULT_PORT): ${YELLOW}no process detected listening${RESET}"
        fi
    fi

    # Paired clients
    local auth_file="$CONFIG_DIR/authorized_clients.json"
    if [[ -f "$auth_file" ]]; then
        local client_count=0
        if command -v jq &>/dev/null; then
            client_count=$(jq '.authorized_tokens | length' "$auth_file" 2>/dev/null || echo 0)
        elif command -v python3 &>/dev/null; then
            client_count=$(python3 -c "import json; f=open('$auth_file'); d=json.load(f); print(len(d.get('authorized_tokens', {})))" 2>/dev/null || echo 0)
        else
            client_count=$(grep -c '": "' "$auth_file" 2>/dev/null || echo 0)
        fi
        if [[ "$LOCALE" == "it" ]]; then
            echo -e "  • Client accoppiati:    ${BOLD}$client_count${RESET} dispositivo/i registrato/i in $auth_file"
        else
            echo -e "  • Paired Clients:     ${BOLD}$client_count${RESET} device(s) registered in $auth_file"
        fi
    fi

    echo ""
    if [[ "$LOCALE" == "it" ]]; then
        log_info "Dettagli completi systemd:"
        systemctl --user status onecontrol.service --no-pager 2>/dev/null || log_warning "Impossibile recuperare lo status systemd dettagliato."
    else
        log_info "Detailed systemd status:"
        systemctl --user status onecontrol.service --no-pager 2>/dev/null || log_warning "Could not retrieve detailed systemd status."
    fi
}

cmd_start() {
    ensure_xdg_runtime
