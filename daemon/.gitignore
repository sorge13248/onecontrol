# ==============================================================================
# Rust Daemon .gitignore
# ==============================================================================

# Cargo build targets
target/
debug/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds
*.pdb

# Profiling and coverage
*.profraw
*.profdata

# Local daemon config fallback (if executed directly from daemon/)
.onecontrol/

# Note: Cargo.lock is intentionally committed for binary applications.
